generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, vector]
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique @map("clerkId")
  email       String   @unique
  firstName   String?
  lastName    String?
  phone       String?
  avatarUrl   String?
  role        Role?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyName String?
  einVerified Boolean @default(false)
  coiUploaded Boolean @default(false)

  properties       Property[]
  leases           Booking[]
  stripeAccount    StripeAccount?
  favorites        Favorite[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  brokerDeals      Deal[]         @relation("BrokerDeals")
  tenantDeals      Deal[]         @relation("TenantDeals")
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  spaceRequests    SpaceRequest[]
}

model StripeAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeAccountId  String   @unique
  onboardingStatus String   @default("PENDING")
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id            String       @id @default(cuid())
  ownerId       String
  title         String
  slug          String       @unique @default(cuid())
  description   String
  propertyType  PropertyType
  sizeSqft      Int
  pricePerMonth Float

  status    PropertyStatus @default(AVAILABLE) // Temporarily default to AVAILABLE to fix TS
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  durationUnit String @default("MONTHS")
  maxDuration  Int    @default(12)
  minDuration  Int    @default(1)

  pricePerDay  Float?
  pricePerHour Float?

  isExternal Boolean @default(false)
  sourceUrl  String?

  embedding      Unsupported("vector")?
  imageEmbedding Unsupported("vector")?

  // PostGIS location
  location Unsupported("geography")?

  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  addressModel      Address?
  images            Media[]
  propertyAmenities PropertyAmenity[]
  availabilities    Availability[]
  leases            Booking[]
  favorites         Favorite[]
  deals             Deal[]
  suites            Suite[]
  activityLogs      ActivityLog[]

  // Legacy / TS Compilation fields (mapped/kept temporarily)
  address   String?
  lat       Float?
  lng       Float?
  capRate   Float?
  leaseType String?
  noi       Float?
  amenities Json    @default("[]")

  @@index([ownerId])
  @@index([status])
  @@index([propertyType])
  @@index([slug])
}

model Address {
  id               String  @id @default(cuid())
  propertyId       String  @unique
  formattedAddress String
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  latitude         Float?
  longitude        Float?
  placeId          String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Media {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  publicId     String?
  resourceType String   @default("IMAGE") // IMAGE, VIDEO
  mimeType     String?
  width        Int?
  height       Int?
  duration     Float?
  sortOrder    Int      @default(0)
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())

  isHero Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("Image")
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  category   String?
  icon       String?
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Availability {
  id         String             @id @default(cuid())
  propertyId String
  startDate  DateTime
  endDate    DateTime
  status     AvailabilityStatus @default(AVAILABLE)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([startDate, endDate])
}

model Booking {
  id         String        @id @default(cuid())
  propertyId String
  tenantId   String
  startDate  DateTime
  endDate    DateTime
  status     BookingStatus @default(PENDING)

  pricingMode String @default("MONTHLY") // MONTHLY, DAILY, HOURLY
  subtotal    Float  @default(0)
  platformFee Float  @default(0)
  total       Float  @default(0)
  currency    String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment  Payment?

  // Legacy mappings for TS
  totalAmount     Float          @default(0)
  bookingType     String         @default("MONTHLY")
  stripePaymentId String?

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("Lease")
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  stripeChargeId          String?       @unique
  status                  PaymentStatus @default(UNPAID)
  amount                  Float
  currency                String        @default("USD")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SpaceRequest {
  id             String       @id @default(cuid())
  tenantId       String
  requiredType   PropertyType
  minSqft        Int
  maxBudget      Float
  durationMonths Int
  city           String
  description    String?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())
  tenant         User         @relation(fields: [tenantId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model UserEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  eventData Json     @default("{}")
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String
  propertyId  String?
  type        String
  title       String
  description String
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  property    Property? @relation(fields: [propertyId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Deal {
  id              String     @id @default(cuid())
  propertyId      String
  tenantId        String
  brokerId        String?
  status          DealStatus @default(INQUIRY)
  commissionFee   Float?
  loiDocumentUrl  String?
  proposedRent    Float?
  leaseTermMonths Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  broker          User?      @relation("BrokerDeals", fields: [brokerId], references: [id])
  property        Property   @relation(fields: [propertyId], references: [id])
  tenant          User       @relation("TenantDeals", fields: [tenantId], references: [id])
}

model Suite {
  id            String   @id @default(cuid())
  propertyId    String
  title         String
  sizeSqft      Int
  pricePerMonth Float
  status        String   @default("AVAILABLE")
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  OWNER
  TENANT
  ADMIN
  BROKER
}

enum PropertyType {
  WAREHOUSE
  FLEX
  OFFICE
  STORAGE
  INDUSTRIAL
  RETAIL
  OTHER
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
  AVAILABLE
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
  UNAVAILABLE
}

enum BookingStatus {
  ACTIVE
  APPROVED
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DealStatus {
  INQUIRY
  TOUR
  LOI_SUBMITTED
  LEASE_SIGNED
  CLOSED
}

enum LeaseStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
}
